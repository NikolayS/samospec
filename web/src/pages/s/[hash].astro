---
import Layout from "../../layouts/Layout.astro";
import { sql, type SpecRow } from "../../lib/db";
import { renderMarkdown } from "../../lib/markdown";
import { verifyCode } from "../../lib/codes";

const { hash } = Astro.params;
if (!hash || !/^[a-z0-9]{6,32}$/.test(hash)) return Astro.redirect("/404");

const rows = await sql<SpecRow[]>`
  select hash, title, body_md, code_hash, code_salt, byte_size, view_count,
         created_at, updated_at
    from specs
   where hash = ${hash}
   limit 1
`;
const spec = rows[0];
if (!spec) return new Response("Not found", { status: 404 });

let needsCode = !!spec.code_hash;
let badCode = false;

if (needsCode) {
  const cookie = Astro.cookies.get(`spec_${spec.hash}`)?.value;
  if (cookie === spec.code_hash) {
    needsCode = false;
  } else if (Astro.request.method === "POST") {
    const form = await Astro.request.formData();
    const submitted = String(form.get("code") ?? "")
      .trim()
      .toUpperCase();
    if (
      submitted &&
      spec.code_salt &&
      spec.code_hash &&
      (await verifyCode(submitted, spec.code_salt, spec.code_hash))
    ) {
      Astro.cookies.set(`spec_${spec.hash}`, spec.code_hash, {
        path: `/s/${spec.hash}`,
        httpOnly: true,
        sameSite: "lax",
        secure: Astro.url.protocol === "https:",
        maxAge: 60 * 60 * 24 * 7,
      });
      needsCode = false;
    } else {
      badCode = true;
    }
  }
}

if (!needsCode) {
  await sql`update specs set view_count = view_count + 1 where hash = ${spec.hash}`;
}

const html = !needsCode ? renderMarkdown(spec.body_md) : "";
const created = spec.created_at.toISOString().slice(0, 10);
---

{
  needsCode ? (
    <Layout title="Enter access code — SamoSpec">
      <form class="gate" method="POST">
        <h1>Access code required</h1>
        <p>This spec is gated. Enter the 6-character code to view it.</p>
        <input
          name="code"
          autocomplete="off"
          autofocus
          maxlength="6"
          spellcheck="false"
          placeholder="XXXXXX"
        />
        {badCode && <div class="error">Incorrect code. Try again.</div>}
        <button type="submit">View spec</button>
      </form>
    </Layout>
  ) : (
    <Layout title={`${spec.title} — SamoSpec`}>
      <article>
        <h1>{spec.title}</h1>
        <div class="spec-meta">
          <span>published {created}</span>
          <span>{Math.ceil(spec.byte_size / 1024)} KiB</span>
          <span>hash {spec.hash}</span>
        </div>
        <div class="spec-body" set:html={html} />
      </article>
    </Layout>
  )
}
